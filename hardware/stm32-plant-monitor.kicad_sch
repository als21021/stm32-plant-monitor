	)
	(text "[ASSUMPTION] Connector pin order follows common modules (web search) - verify against board silkscreen\nJ1 HW-390: GND / VCC / AOUT (work report 2026-10-12)\nJ2 GY-302: VCC / GND / SCL / SDA / ADDR, on-board I2C pull-ups, ADDR=GND -> 0x23\nJ3 microSD (Catalex type): GND / VCC / MISO / MOSI / SCK / CS, VCC 5V (on-board 3.3V LDO)\nJ4 relay input: IN / GND / VCC(5V) (verified 2026-10-14), S8550 PNP low-trigger:\nPA8 open-drain + R2 10k pull-up to +5V (3.3V HIGH cannot turn relay OFF)\nJ6 relay contacts: NO / COM / NC (verify terminal order)"
		(exclude_from_sim no)
		(at 175.26 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d2a8646f-7143-4bc7-afc9-24a1f3129067")
	)
	(text "SR-04: pump supply (PUMP_5V / PUMP_GND) isolated from MCU supply\nD1 flyback: cathode -> PUMP_POS, anode -> PUMP_GND\nR1 330R: ~4mA for red LED, use ~100R for white/blue LED"
		(exclude_from_sim no)
		(at 182.88 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ffa030b2-5425-430f-b09f-892b2dcdc059")
	)
